MYSQL_PASSWORD=123456
MYSQL_DB=wandermeet

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 互亿无线短信（单条发送 Submit.json）；填空则开发环境仅在日志打印验证码，生产环境必须配置
IHUYI_ACCOUNT=
IHUYI_PASSWORD=
# 须与报备模板一致；用 {code} 占位验证码
IHUYI_SMS_TEMPLATE=您的验证码是：{code}。请不要把验证码泄露给其他人。
