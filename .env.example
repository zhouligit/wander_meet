APP_NAME=WanderMeet API
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://wang-hao-hao.cn,https://www.wang-hao-hao.cn

# JWT 签名密钥（生产必填强随机串）；不填则兼容旧规则 app_name+mysql_db
JWT_SECRET=
# Access / Refresh 有效期（秒）
ACCESS_TOKEN_EXPIRES_SECONDS=7200
REFRESH_TOKEN_EXPIRES_SECONDS=604800
# 0=关闭；发验证码/短信登录 按 IP 每分钟上限
AUTH_SMS_IP_LIMIT_PER_MINUTE=30
AUTH_LOGIN_IP_LIMIT_PER_MINUTE=120
AUTH_WECHAT_LOGIN_IP_LIMIT_PER_MINUTE=120
# H5 邮箱注册 / 登录（见 doc/mail_login.md）
AUTH_EMAIL_REGISTER_IP_LIMIT_PER_MINUTE=20
AUTH_EMAIL_LOGIN_IP_LIMIT_PER_MINUTE=60
AUTH_EMAIL_REGISTER_MIN_INTERVAL_SECONDS=60
AUTH_EMAIL_LOGIN_MAX_FAILURES=5
AUTH_EMAIL_LOGIN_LOCK_SECONDS=900
AUTH_EMAIL_FORGOT_IP_LIMIT_PER_MINUTE=10
AUTH_EMAIL_FORGOT_MIN_INTERVAL_SECONDS=60
AUTH_EMAIL_RESET_CODE_TTL_SECONDS=900

# H5 忘记密码发信（见 doc/mail_login.md §3.6）
EMAIL_USE_MOCK=true
EMAIL_MOCK_CODE=123456
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_STARTTLS=false

# 微信小程序登录（wx.login → POST /auth/wechat/login）
WX_MP_APPID=
WX_MP_APPSECRET=
# 本地联调 true：不调微信，用 code 派生 mock openid；生产务必 false
WX_MP_USE_MOCK=false
# 微信小程序内容安全（msgSecCheck）；提审/生产须 true
WX_CONTENT_SEC_ENABLED=true

# 抖音小程序登录（tt.login → POST /auth/douyin/login）
DY_MP_APPID=
DY_MP_APPSECRET=
# 本地联调 true：不调抖音，用 code 派生 mock openid；生产务必 false
DY_MP_USE_MOCK=false

# 发布活动付费（见 doc/wx_pay.md、doc/pay_api.md）
# wechat=官方 APIv3（默认）；yungou=遗留备选，后期可下线
PAY_PROVIDER=wechat
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=
# 商户 API 私钥 PEM 文件路径，或下面 WECHAT_PAY_PRIVATE_KEY 填 PEM 正文
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=https://www.wang-hao-hao.cn/api/v1/wm/pay/wechat/notify
# 本地无商户证书时 true：不调微信，返回 mock 支付链接/参数
WECHAT_PAY_USE_MOCK=false

# YunGouOS（仅 PAY_PROVIDER=yungou 时使用，生产建议不配）
YUNGOU_MCH_ID=
YUNGOU_API_KEY=
YUNGOU_NATIVE_API=https://api.pay.yungouos.com/api/pay/wxpay/nativePay
YUNGOU_MINAPP_API=https://api.pay.yungouos.com/api/pay/wxpay/minAppPay
YUNGOU_NOTIFY_URL=https://www.wang-hao-hao.cn/api/v1/wm/pay/yungou/notify
YUNGOU_USE_MOCK=false
# 完整多步新手引导（false=登录后仅昵称+性别一页，见 doc/WanderMeet_新手引导_产品与进度.md）
ONBOARDING_FULL_ENABLED=false
# 发布活动前是否要求付费（false=免费发布，前端不调起支付）
PAY_PUBLISH_ENABLED=false
PAY_PUBLISH_FEE_YUAN=0.10
PAY_PUBLISH_BODY=发布活动
PAY_PUBLISH_PRODUCT=publish
PAY_ORDER_TTL_SECONDS=1800
YUNGOU_PAY_SUCCESS_CODE=1

# 百度 BOS（头像等用户资源，见 app/services/bos_storage.py）
# 控制台创建 Bucket 后填写；BOS_PUBLIC_BASE_URL 为对外访问域名（Bucket 域名或 CDN）
BOS_ACCESS_KEY_ID=
BOS_SECRET_ACCESS_KEY=
BOS_BUCKET=
# 区域 Endpoint，如 https://bj.bcebos.com
BOS_ENDPOINT=https://bj.bcebos.com
# 公网访问前缀，如 https://your-bucket.bd.bcebos.com（区域与 Bucket 一致，保定为 bd）
BOS_PUBLIC_BASE_URL=
# 头像单文件上限（字节，默认 5MB）
BOS_AVATAR_MAX_BYTES=5242880
# 聊天图片单文件上限（字节，默认 8MB）
BOS_CHAT_IMAGE_MAX_BYTES=8388608
# 预签名 PUT 有效期（秒）
BOS_PRESIGN_EXPIRES_SECONDS=1800

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wandermeet
MYSQL_PASSWORD=123456
MYSQL_DB=wandermeet
# 小于 MySQL wait_timeout；云上实例 idle 超时短时可改为 300～3600
MYSQL_POOL_RECYCLE_SECONDS=28000
# 每 worker 连接池：pool_size + max_overflow 为峰值连接数；2 workers 时总峰值约 2 倍
MYSQL_POOL_SIZE=3
MYSQL_MAX_OVERFLOW=2

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 活动同城列表 Redis 短缓存（见 doc/PERF_Cache_and_Scale.md）
CACHE_ACTIVITY_LIST_ENABLED=true
CACHE_ACTIVITY_LIST_TTL_SECONDS=60
# 鉴权用户行 / GET /me、/me/stats
CACHE_USER_AUTH_ENABLED=true
CACHE_USER_AUTH_TTL_SECONDS=300
CACHE_ME_ENABLED=true
CACHE_ME_TTL_SECONDS=30
# GET /meta 静态接口 HTTP Cache-Control（秒）；0=不设置
META_HTTP_CACHE_MAX_AGE_SECONDS=3600

# 测试阶段 true：不发短信不扣费，验证码固定为 SMS_MOCK_CODE；上线改为 false
SMS_USE_MOCK=true
SMS_MOCK_CODE=123456
# 短信渠道：ihuyi=互亿无线（默认）| aliyun=阿里云
SMS_PROVIDER=ihuyi

# 互亿无线（SMS_USE_MOCK=false 且 SMS_PROVIDER=ihuyi）
IHUYI_ACCOUNT=
IHUYI_PASSWORD=
IHUYI_SMS_TEMPLATE=您的验证码是：{code}。请不要把验证码泄露给其他人。

# 验证码在服务端（Redis）有效秒数，默认 300=5 分钟
# SMS_CODE_TTL_SECONDS=300
# 同一手机号两次发码最小间隔（秒），默认 60
# SMS_SEND_MIN_INTERVAL_SECONDS=60

# 阿里云（SMS_USE_MOCK=false 且 SMS_PROVIDER=aliyun）
# 控制台：https://dysms.console.aliyun.com/ ；OpenAPI 文档：https://next.api.aliyun.com/api/Dysmsapi/2017-05-25/SendSms
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
# 模板 CODE，如 SMS_123456789；模板内变量名须与代码中 template_param 一致（默认仅传 code）
ALIYUN_SMS_TEMPLATE_CODE=
# 可选；默认 dysmsapi.aliyuncs.com、cn-hangzhou
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# ALIYUN_SMS_REGION_ID=cn-hangzhou
# 模板含 ${minute} 时改为 true，与验证码 TTL（5 分钟）一致多传 minute
# ALIYUN_SMS_TEMPLATE_INCLUDE_MINUTE=false
